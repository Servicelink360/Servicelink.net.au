# PostgreSQL connection string
DATABASE_URL=postgresql://servicelink:servicelink@localhost:5432/servicelink

# Service360 API (read-only ops stats for homepage / Service360 page)
# Local: http://127.0.0.1:5301 | Production: https://api.service360.com.au
SERVICE360_API_URL=https://api.service360.com.au
# Must match PUBLIC_STATS_API_KEY on the Service360 API
SERVICE360_STATS_API_KEY=

# Google Gemini API (for SEO content generation scripts)
GEMINI_API_KEY=
# Optional: gemini-2.0-flash (default), gemini-2.5-flash, etc.
GEMINI_MODEL=gemini-2.0-flash
# Delay between API calls in ms (default 4000 — ~15 req/min on free tier)
GEMINI_DELAY_MS=4000
# Wait time when rate limited in ms (default 65000)
GEMINI_RATE_LIMIT_WAIT_MS=65000

# Brevo transactional email (contact + quote form notifications)
# API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Must be a verified sender in Brevo
BREVO_SENDER_EMAIL=helpdesk@servicelink.net.au
BREVO_SENDER_NAME=Servicelink
# Where form notifications are delivered (defaults to helpdesk@servicelink.net.au)
BREVO_TO_EMAIL=helpdesk@servicelink.net.au
